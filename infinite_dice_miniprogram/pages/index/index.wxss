.page {
  padding: 32rpx 24rpx 60rpx;
}

.hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f9c84e, #f39b2e);
  color: #241a08;
  font-weight: 700;
  font-size: 44rpx;
}

.hero-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.subtitle {
  color: #9da6c3;
  font-size: 24rpx;
}

.card {
  background: #22273d;
  padding: 24rpx;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 20rpx 40rpx rgba(10, 12, 26, 0.35);
}

.card-title {
  font-size: 32rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.emoji {
  font-size: 34rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: #9da6c3;
  line-height: 1.6;
}

.table {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.row {
  display: grid;
  grid-template-columns: 1.1fr 0.8fr 1.6fr;
  gap: 10rpx;
  align-items: center;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
}

.row.header {
  background: transparent;
  color: #9da6c3;
  text-transform: uppercase;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 700;
  font-size: 24rpx;
}

.pill.pink {
  background: linear-gradient(135deg, #ff6f91, #ff9671);
  color: #fff;
}

.pill.yellow {
  background: #ffcc00;
  color: #1a1400;
}

.pill.green {
  background: #4cd964;
  color: #0b2a0e;
}

.pill.cyan {
  background: #25d0d7;
  color: #042224;
}

.alert {
  background: linear-gradient(135deg, rgba(178, 54, 54, 0.3), rgba(146, 59, 44, 0.5));
  border-radius: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 120, 120, 0.3);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  line-height: 1.6;
}

.alert-title {
  font-weight: 700;
}

.muted {
  color: #f7c9c9;
  font-size: 22rpx;
}

.controls {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

button {
  border-radius: 18rpx;
  font-weight: 700;
  padding: 10rpx 24rpx;
}

.primary {
  background: linear-gradient(135deg, #f9c84e, #f39b2e);
  color: #2a1903;
}

.secondary {
  background: #ffffff14;
  color: #f4f7ff;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.ghost {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #9da6c3;
}

.status {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160rpx, 1fr));
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.label {
  color: #9da6c3;
  font-size: 20rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.value {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.dice-area {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  min-height: 80rpx;
  margin-bottom: 14rpx;
}

.dice {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: #ffffff1a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.log {
  color: #9da6c3;
  font-size: 22rpx;
  line-height: 1.6;
  max-height: 280rpx;
  overflow: hidden;
}

.footer {
  text-align: center;
  color: #ffb02e;
  font-weight: 700;
  margin-top: 24rpx;
}

@media (max-width: 640px) {
  .row {
    grid-template-columns: 1fr;
    gap: 6rpx;
  }
}
